-vmx_return_rip_for_vmxoff(VOID)
-{
-    UINT32                  core_id = (UINT32)(__readmsr(IA32_TSC_AUX) & 0xFFF);
-    VIRTUAL_MACHINE_STATE * vcpu   = &g_vcpu[core_id];
