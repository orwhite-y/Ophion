-'    if (fault_shadow_pte_va)\n'
-'    {\n'
-'        UINT64 want = real_pte & ~NX_BIT;\n'
-'        if (fault_intercept_write)\n'
-'            want &= ~0x2ULL;                          // keep W=0 for protected pages\n'
