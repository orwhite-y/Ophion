index bbadd09..d5e4906 100644
--- a/Ophion-master/asm/AsmHostIdt.asm
+++ b/Ophion-master/asm/AsmHostIdt.asm
@@ -8,11 +8,14 @@ PUBLIC asm_host_pf_handler
 PUBLIC asm_host_default_handler
 
 EXTERN g_host_nmi_pending:DWORD
+EXTERN g_pf_safe_start:QWORD
+EXTERN g_pf_safe_end:QWORD
+EXTERN g_pf_recovery_count:DWORD
 
 .code _text
 
 
-; NMI handler ??sets per-cpu pending flag, vmexit handler injects to guest
+; NMI handler sets per-cpu pending flag, vmexit handler injects to guest
 
 asm_host_nmi_handler PROC
 
@@ -67,7 +70,7 @@ asm_host_default_handler PROC
 asm_host_default_handler ENDP
 
 
-; #PF in host mode = skip faulting instruction (best effort survival)
+; #PF in host mode
 ; Stack frame (64-bit, IST=0):
 ;   [rsp+0]  = error code
 ;   [rsp+8]  = RIP
@@ -75,13 +78,49 @@ asm_host_default_handler ENDP
 ;   [rsp+24] = RFLAGS
 ;   [rsp+32] = RSP
 ;   [rsp+40] = SS
+;
+; If RIP is in [g_pf_safe_start, g_pf_safe_end) (stealth self-map walk range):
+;   recover: RAX=0 (not-present PTE), advance RIP by 3 (past 3-byte mov reg,[reg])
+;   The faulting instruction inside stealth_walk_pte_selfmap / stealth_walk_pt_page_selfmap
+;   is a 3-byte "mov rax,[reg]" (48 8B 00 / 48 8B 01 / etc). Setting RAX=0 makes the
+;   caller see P=0 (not-present), which the retry loop + fallback handles.
+; Otherwise: halt (unrecoverable #PF in VMX-root)
 
 asm_host_pf_handler PROC
 
-    add     qword ptr [rsp + 8], 1     ; advance RIP past faulting instr
-    add     rsp, 8                     ; discard error code
+    mov     rax, [rsp + 8]              ; faulting RIP (before any push)
+    push    r10
+    push    r11
+
+    ; Check RIP >= g_pf_safe_start
+    lea     r10, g_pf_safe_start
+    mov     r11, [r10]
+    cmp     rax, r11
+    jb      pf_halt
+
+    ; Check RIP < g_pf_safe_end
+    lea     r10, g_pf_safe_end
+    mov     r11, [r10]
+    cmp     rax, r11
+    jae     pf_halt
+
+    ; In safe range: recover
+    xor     rax, rax                    ; RAX=0 (not-present PTE for caller)
+    lea     r10, g_pf_recovery_count
+    lock inc dword ptr [r10]            ; increment recovery counter
+    pop     r11
+    pop     r10
+    add     qword ptr [rsp + 8], 3      ; advance RIP by 3 (past 3-byte mov)
+    add     rsp, 8                      ; discard error code
     iretq
 
+pf_halt:
+    pop     r11
+    pop     r10
+    cli
+    hlt
+    jmp     $
+
 asm_host_pf_handler ENDP
 
-END
+END
