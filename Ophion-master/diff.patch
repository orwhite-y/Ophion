-new1 = (
-'    // Resolve the shadow PTE VA for fault_addr. For DLL stealth pages this is\n'
-'    // sp_data->shadow_pte_va. For non-stealth pages (heap/stack/TLS) that live\n'
-'    // in a CLONED shadow PT (same 2MB range as DLL code), the shadow PTE is a\n'
-'    // stale snapshot that must be synced from the real PTE - otherwise every\n'
-'    // shadow-window data access re-faults and bails = livelock (system hang).\n'
-'    // Derive the PTE address from a neighboring stealth page in the same PT.\n'
-'    PVOID    fault_shadow_pte_va  = NULL;\n'
-'    BOOLEAN  fault_intercept_write = FALSE;\n'
-'\n'
-'    if (sp_data && sp_data->shadow_pte_va)\n'
-'    {\n'
-'        fault_shadow_pte_va   = sp_data->shadow_pte_va;\n'
-'        fault_intercept_write = sp_data->intercept_write;\n'
-'    }\n'
-'    else\n'
-'    {\n'
-'        // Non-stealth page: find a neighbor stealth page in the same 2MB range\n'
-'        // (same PD index + same shadow CR3) to locate the cloned shadow PT page.\n'
-'        UINT32 fault_pd_idx = (UINT32)((fault_addr >> 21) & 0x1FF);\n'
-'        PLIST_ENTRY cur3 = g_ept->stealth_pages.Flink;\n'
-'        while (cur3 != &g_ept->stealth_pages)\n'
-'        {\n'
-'            PEPT_STEALTH_PAGE_INFO s = CONTAINING_RECORD(cur3,\n'
-'                EPT_STEALTH_PAGE_INFO, stealth_page_list);\n'
-'            cur3 = s->stealth_page_list.Flink;\n'
-'            if (s->shadow_cr3_phys != sp->shadow_cr3_phys) continue;\n'
-'            if (((s->guest_va >> 21) & 0x1FF) != fault_pd_idx) continue;\n'
-'            if (s->target_pid != 0)\n'
-'            {\n'
-'                if ((UINT64)(ULONG_PTR)PsGetCurrentProcessId() != s->target_pid)\n'
-'                    continue;\n'
-'            }\n'
-'            else if (s->guest_cr3 != 0 &&\n'
-'                     (s->guest_cr3 & PFN_MASK) != (real_cr3 & PFN_MASK))\n'
-'                continue;\n'
-'            if (!s->shadow_pte_va || s->pt_pte_index >= 512) continue;\n'
-'            // Same 2MB PT page: derive fault_addr shadow PTE from neighbor.\n'
-'            PUINT64 shadow_pt_base = (PUINT64)((PUCHAR)s->shadow_pte_va\n'
-'                                               - (SIZE_T)s->pt_pte_index * 8);\n'
-'            UINT32 fault_pte_idx = (UINT32)((fault_addr >> 12) & 0x1FF);\n'
-'            fault_shadow_pte_va = &shadow_pt_base[fault_pte_idx];\n'
-'            break;\n'
-'        }\n'
-'        // If still NULL, the page shares the real PT (not in any cloned shadow\n'
-'        // PT). real P=1 => TLB-stale spurious #PF (INVVPID + resume); real P=0\n'
-'        // => genuine demand fault (bail). Decided after the real walk below.\n'
-'    }\n'
-'\n'
-'    // A write to a write-protected stealth page (intercept_write, shadow W=0)\n'
-'    // must stay mediated - do NOT heal it (healing sets W=1 and lets the write\n'
-'    // through). Let it reinject so the write-mediation path handles it.\n'
-'    if (is_write && fault_intercept_write)\n'
-'        return FALSE;'
-)
